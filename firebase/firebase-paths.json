{
  "version": 1,
  "variables": {
    "uid": "Firebase Auth user UID",
    "deviceId": "Stable VOLTIX device identifier",
    "historyId": "Stable completed-session identifier"
  },
  "paths": {
    "userProfile": "/users/{uid}/profile",
    "userSettings": "/users/{uid}/settings",
    "userHistoryProjection": "/users/{uid}/history/{historyId}",
    "deviceRoot": "/devices/{deviceId}",
    "deviceConfig": "/devices/{deviceId}/config",
    "deviceLive": "/devices/{deviceId}/live",
    "deviceLiveSystem": "/devices/{deviceId}/live/system",
    "deviceLiveMeasurement": "/devices/{deviceId}/live/device",
    "deviceCommand": "/devices/{deviceId}/command",
    "deviceHistory": "/devices/{deviceId}/history/{historyId}",
    "developmentCompletedSessionQueue": "/devices/{deviceId}/completedSessions/{historyId}",
    "developmentCommandCurrent": "/devices/{deviceId}/commands/current",
    "developmentCommandLastAck": "/devices/{deviceId}/commands/lastAck"
  }
}
