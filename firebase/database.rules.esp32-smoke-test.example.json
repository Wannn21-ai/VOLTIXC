{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "esp32-voltix-001": {
        "config": {
          ".read": true,
          ".write": "auth != null && auth.token.deviceRole !== 'hardware'"
        },
        "live": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware'",
          ".write": true
        },
        "commands": {
          "current": {
            ".read": true,
            ".write": "!newData.exists() || (auth != null && auth.token.deviceRole !== 'hardware')"
          },
          "lastAck": {
            ".read": "auth != null && auth.token.deviceRole !== 'hardware'",
            ".write": true
          }
        },
        "history": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware'",
          ".write": true
        },
        "completedSessions": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware'",
          ".write": true
        },
        "historyCleanup": {
          "current": {
            ".read": true,
            ".write": "!newData.exists() || (auth != null && auth.token.deviceRole !== 'hardware')"
          },
          "lastAck": {
            ".read": "auth != null && auth.token.deviceRole !== 'hardware'",
            ".write": true
          }
        }
      }
    }
  }
}
