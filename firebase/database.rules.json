{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.token.deviceRole !== 'hardware' && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.token.deviceRole !== 'hardware' && auth.uid === $uid",
          ".validate": "newData.hasChildren(['displayName', 'email', 'createdAt']) && newData.child('displayName').isString() && newData.child('email').isString() && newData.child('createdAt').isNumber()"
        },
        "settings": {
          ".write": "auth != null && auth.token.deviceRole !== 'hardware' && auth.uid === $uid"
        },
        "history": {
          ".write": "auth != null && auth.token.deviceRole !== 'hardware' && auth.uid === $uid",
          "$historyId": {
            ".validate": "!newData.exists() || newData.child('deviceId').isString()"
          }
        }
      }
    },
    "devices": {
      "$deviceId": {
        "name": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          ".write": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "firmwareVersion": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          ".write": "auth != null && auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId",
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          ".write": false
        },
        "lastSeen": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          ".write": "auth != null && auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId",
          ".validate": "newData.isNumber()"
        },
        "deviceAuth": {
          ".read": false,
          ".write": false
        },
        "config": {
          ".read": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'))",
          ".write": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'))",
          ".validate": "newData.hasChildren(['currency', 'tariff', 'overloadThreshold', 'overloadWarningPercent', 'loadPowerThreshold', 'loadCurrentThreshold', 'loadRemovedDelaySec', 'offlineTimeoutSec', 'checkpointIntervalSec']) && newData.child('currency').isString() && newData.child('tariff').isNumber() && newData.child('tariff').val() > 0 && newData.child('overloadThreshold').isNumber() && newData.child('overloadThreshold').val() > 0 && newData.child('overloadWarningPercent').isNumber() && newData.child('overloadWarningPercent').val() >= 1 && newData.child('overloadWarningPercent').val() <= 100 && newData.child('loadPowerThreshold').isNumber() && newData.child('loadPowerThreshold').val() > 0 && newData.child('loadCurrentThreshold').isNumber() && newData.child('loadCurrentThreshold').val() > 0 && newData.child('loadRemovedDelaySec').isNumber() && newData.child('loadRemovedDelaySec').val() > 0 && newData.child('offlineTimeoutSec').isNumber() && newData.child('offlineTimeoutSec').val() > 0 && newData.child('checkpointIntervalSec').isNumber() && newData.child('checkpointIntervalSec').val() > 0"
        },
        "live": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          ".write": "auth != null && auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId"
        },
        "command": {
          ".read": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'))",
          ".write": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          ".validate": "newData.hasChildren(['relay', 'startSession', 'stopSession', 'resetAlarm', 'updatedAt']) && newData.child('relay').isString() && (newData.child('relay').val() === 'ON' || newData.child('relay').val() === 'OFF' || newData.child('relay').val() === 'UNCHANGED') && newData.child('startSession').isBoolean() && newData.child('stopSession').isBoolean() && newData.child('resetAlarm').isBoolean() && newData.child('updatedAt').isNumber()"
        },
        "commands": {
          "current": {
            ".read": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'))",
            ".write": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId && !newData.exists()) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'))"
          },
          "lastAck": {
            ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
            ".write": "auth != null && auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId"
          }
        },
        "history": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          "$historyId": {
            ".write": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001' && !newData.exists()))"
          }
        },
        "completedSessions": {
          ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
          "$historyId": {
            ".write": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001' && !newData.exists()))"
          }
        },
        "historyCleanup": {
          "current": {
            ".read": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'))",
            ".write": "auth != null && ((auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId && !newData.exists()) || (auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'))",
            ".validate": "!newData.exists() || (auth.token.deviceRole !== 'hardware' && newData.hasChildren(['type', 'requestId', 'requestedBy', 'createdAt']) && ((newData.child('type').val() === 'DELETE_HISTORY_SESSION' && newData.child('sessionIds').exists()) || (newData.child('type').val() === 'DELETE_ALL_HISTORY' && newData.child('beforeTs').isNumber())) && newData.child('requestId').isString() && newData.child('requestedBy').val() === auth.uid && newData.child('createdAt').isNumber())"
          },
          "lastAck": {
            ".read": "auth != null && auth.token.deviceRole !== 'hardware' && $deviceId === 'esp32-voltix-001'",
            ".write": "auth != null && auth.token.deviceRole === 'hardware' && auth.token.deviceId === $deviceId"
          }
        }
      }
    }
  }
}
