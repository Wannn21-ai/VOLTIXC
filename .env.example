# Firebase Web App config is retained only for Firebase Authentication.
# Keep real values in .env.local or the hosting provider environment dashboard.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# PostgreSQL stores live snapshots, settings, command acknowledgements, and
# completed-session history. MQTT itself is transport, not permanent storage.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Server-only HiveMQ credential returned only after Firebase user verification.
# Create a dedicated read-only MQTT user limited to voltix/device01 status,
# telemetry, session, and event topics. Never reuse the ESP32 credential here.
MQTT_WEB_USERNAME=
MQTT_WEB_PASSWORD=

# Dedicated backend/worker credential. Grant subscribe access to device output
# topics and publish access only to command, config, and history/ack topics.
MQTT_SERVICE_USERNAME=
MQTT_SERVICE_PASSWORD=
MQTT_WORKER_CLIENT_ID=voltix-backend-worker

# Firebase Admin is used only to verify Firebase Authentication ID tokens.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Legacy token-broker value. Only needed while running the old isolated
# device-token endpoint; the MQTT firmware does not use it.
FIREBASE_DATABASE_URL=
DEVICE_AUTH_PEPPER=

# Local lab workflow only. Never configure these as public/web variables.
TOKEN_BROKER_URL=
DEVICE_ID=
DEVICE_SECRET=
CREDENTIAL_VERSION=
OWNER_UID=
