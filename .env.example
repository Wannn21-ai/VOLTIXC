# Firebase Web App config names only, except FIREBASE_DATABASE_URL which is
# also required by the server token broker. Keep real values in .env.local or
# the hosting provider environment-variable dashboard.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server-only HiveMQ credential returned only after Firebase user verification.
# Create a dedicated read-only MQTT user limited to voltix/device01 status,
# telemetry, session, and event topics. Never reuse the ESP32 credential here.
MQTT_WEB_USERNAME=
MQTT_WEB_PASSWORD=

# Token broker server-only credentials. Never expose these to web or firmware.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DEVICE_AUTH_PEPPER=

# Local lab workflow only. Never configure these as public/web variables.
TOKEN_BROKER_URL=
DEVICE_ID=
DEVICE_SECRET=
CREDENTIAL_VERSION=
OWNER_UID=
