# Firebase Web App config names only, except FIREBASE_DATABASE_URL which is
# also required by the server token broker. Keep real values in .env.local or
# the hosting provider environment-variable dashboard.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Token broker server-only credentials. Never expose these to web or firmware.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DEVICE_AUTH_PEPPER=
